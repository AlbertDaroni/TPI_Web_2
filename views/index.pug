extends layout

block estilo
  link(rel="stylesheet", href="/stylesheets/index.css")

block content
  div#contenido
    if (datos && datos.length > 0)
      each dato in datos 
        include index_pub.pug 
    else 
      div.no-publicaciones
        h2 Aún no hay publicaciones 
        p ¡Creá la tuya!
    div#marcador-final

  script.
    const cachePublicaciones = {};
    const id_usuario = !{JSON.stringify(usuario ? usuario.id : null)};
    const ver = !{JSON.stringify(ver || null)};
    
    const datosIniciales = !{JSON.stringify(datos || [])};
    datosInteresantes(datosIniciales);

    function datosInteresantes(listaPosts) {
      listaPosts.forEach(pub => {
        cachePublicaciones[pub.id] = {
          imagenes: pub.Imagens,
          comentarios: pub.Comentarios
        };
      });
    }

    // ACTUALIZAR LIKES
    async function actualizarLikes(id, valoracion) {
      try {
        const res = await fetch(`/publicacion/${id}/valoracion`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ valoracion: valoracion })
        });
        const data = await res.json();
        document.getElementById(`valoracion-pub-${id}`).innerText = data.promedio + '%';
      } catch(error) { console.error('No se actualizó la valoración correctamente', error); }
    }

    // MOSTRAR / OCULTAR COMENTARIOS (Corregido leyendo del caché)
    function alternarComentarios(id) {
      const seccion_comentarios = document.getElementById(`seccion-comentarios-${id}`);
      const contenedor_comentarios = document.getElementById(`lista-comentarios-pub-${id}`);
      
      // Obtenemos los comentarios desde el caché global
      const comentarios = cachePublicaciones[id]?.comentarios || [];

      if (seccion_comentarios.style.display === 'none') {
        contenedor_comentarios.innerHTML = '';

        comentarios.forEach(comentario => {
          const esMio = id_usuario && comentario.id_usuario === id_usuario;
          const foto_perfil = comentario.Usuario.foto_perfil;
          const nombre = comentario.Usuario.nombre;
          const id_comentario = comentario.id;
          const fecha_creacion = new Date(comentario.createdAt).toLocaleString();
          const texto = comentario.texto;
          const denuncias = comentario.denuncias || 0;

          let htmlComentario = '';

          if (id_usuario && esMio) {
            htmlComentario = `
              <div class="comentario-item">
                <img src="${foto_perfil}" width="32">
                  <div class="comentario-cuerpo">
                    <p><strong>${fecha_creacion}</strong></p>
                    <h5>${nombre}</h5>
                    <p>${texto}</p>
                    <div class="comentario-acciones">
                      <a href="/publicacion/${id}/comentario/${id_comentario}/eliminar">🗑️</a>
                      <button onclick="alternarModificacionComentario(${id_comentario})">✏️</button>
                      <button type="button">🚩 ${denuncias}</button>
                      <div id="seccion-modificar-comentario-${id_comentario}" style="display: none;">
                        <form action="/publicacion/${id}/comentario/${id_comentario}/modificar" method="post">
                          <textarea name="nuevoComentario" rows="2">${texto}</textarea>
                          <button type="submit">📩</button>
                        </form>
                      </div>
                    </div>
                  </div>
              </div>
            `;
          } else {
            htmlComentario = `
              <div class="comentario-item">
                <img src="${foto_perfil}" width="32">
                  <div class="comentario-cuerpo">
                    <p><strong>${fecha_creacion}</strong></p>
                    <h5>${nombre}</h5>
                    <p>${texto}</p>
                    <div class="comentario-acciones">
                      <a href="/publicacion/comentario/${id_comentario}/denunciar">🚩</a>
                    </div>
                  </div>
              </div>
            `;
          }
          contenedor_comentarios.insertAdjacentHTML('beforeend', htmlComentario);
        });

        seccion_comentarios.style.display = 'block';
      } else {
        seccion_comentarios.style.display = 'none';
      }
    }

    function alternarModificacionComentario(idCom) {
      const seccion = document.getElementById(`seccion-modificar-comentario-${idCom}`);
      seccion.style.display === 'none' ? seccion.style.display = 'block' : seccion.style.display = 'none';
    }

    function marcarInteres(idPub) {
      const motivo_Interes = document.getElementById(`motivo-interes-${idPub}`);
      motivo_Interes.style.display === 'none' ? motivo_Interes.style.display = 'block' : motivo_Interes.style.display = 'none';
    }

    function guardarPublicacion(idPub) {
      const seccion = document.getElementById(`guardarPublicacion-${idPub}`);
      seccion.style.display === 'none' ? seccion.style.display = 'block' : seccion.style.display = 'none';
    }

    // MOSTRAR SIGUIENTE/ANTERIOR IMAGEN (Corregido leyendo del caché)
    const carruselStatus = {};

    function mover(idPub, direccion) {
      const contenedor_imagen = document.getElementById(`imagen-container-${idPub}`);
      const labelPosicion = document.getElementById(`pos-${idPub}`);
      
      // Leemos el set de imágenes del caché
      const imagenes = cachePublicaciones[idPub]?.imagenes || [];
      const total = imagenes.length;

      if (total <= 1) return;

      if (carruselStatus[idPub] === undefined) carruselStatus[idPub] = 0;
      carruselStatus[idPub] += direccion;

      if (carruselStatus[idPub] >= total) carruselStatus[idPub] = 0;
      if (carruselStatus[idPub] < 0) carruselStatus[idPub] = total - 1;

      const nuevaImagen = imagenes[carruselStatus[idPub]];
      
      if (id_usuario) {
        contenedor_imagen.innerHTML = `
          <img src="${nuevaImagen.imagen}" class="main-img" style="width: auto; max-width: 100%; height: auto; max-height: 500px; display: block; margin: 0 auto;">
          <p>${(nuevaImagen.licencia) ? 'Imagen sin licencia' : 'Imagen con licencia'}</p>
        `;
      } else if (nuevaImagen.licencia) {
        contenedor_imagen.innerHTML = `
          <img src="/images/imagen_censurada.png" class="main-img" style="width: auto; max-width: 100%; height: auto; max-height: 500px; display: block; margin: 0 auto;">
          <p>Imagen con licencia</p>
        `;
      } else {
        contenedor_imagen.innerHTML = `
          <img src="${nuevaImagen.imagen}" class="main-img" style="width: auto; max-width: 100%; height: auto; max-height: 500px; display: block; margin: 0 auto;">
          <p>Imagen sin licencia</p>
        `;
      }

      labelPosicion.innerText = `${carruselStatus[idPub] + 1} / ${total}`;
    }

    // SCROLL INFINITO (Corregido el contenedor padre e inyección en el caché)
    const marcador = document.querySelector('#marcador-final');
    let idsCargados = [];
    let cargando = false;
    
    // Mapeamos los IDs iniciales impresos en el DOM
    document.querySelectorAll('.contenedor-post').forEach(pub => idsCargados.push(Number(pub.dataset.id)));

    const cargarPublicaciones = async () => {
      if (cargando || ver) return;
      cargando = true;

      try {
        // Apuntamos al contenedor principal del contenido
        const contenedorContenido = document.querySelector('#contenido');
        
        const res = await fetch('/', { 
            method: 'POST', 
            headers: { 'Content-Type': 'application/json' }, 
            body: JSON.stringify({ idsCargados }) 
        });
        const data = await res.json();

        if (data.finalizar) {
            observador.unobserve(marcador);
            return;
        }

        // Almacenamos en el caché global los comentarios e imágenes de los nuevos posts recibidos
        datosInteresantes(data.datosNuevos);

        // Inyectamos las publicaciones renderizadas justo antes del marcador final
        marcador.insertAdjacentHTML('beforebegin', data.html);

        // Actualizamos nuestra lista de exclusión de IDs
        idsCargados = [];
        document.querySelectorAll('.contenedor-post').forEach(pub => idsCargados.push(Number(pub.dataset.id)));

      } catch(error) { 
          console.error('Error al cargar más publicaciones:', error);
      } finally { cargando = false; }
    };

    const observador = new IntersectionObserver((entries) => { if (entries[0].isIntersecting) cargarPublicaciones(); }, { rootMargin: '300px' });

    if (marcador) observador.observe(marcador);