extends layout

block estilo
  link(rel="stylesheet", href="/stylesheets/index.css")

block content
  div#contenido
    if (publicaciones && publicaciones.length > 0)
      each pub in publicaciones 
        include index_pub.pug 
    else 
      div.no-publicaciones
        h2 Aún no hay publicaciones 
        p ¡Creá la tuya!
    div#marcador-final

  script.
    window.id_usuario = !{JSON.stringify(usuario ? usuario.id : null)};
    window.datosIniciales = !{JSON.stringify(publicaciones || [])};
    window.tieneDenuncias = !{JSON.stringify(tieneDenuncias || false)};
  script(src="/scripts/index.js") 