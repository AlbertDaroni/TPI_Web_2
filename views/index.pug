extends layout

block estilo
  link(rel="stylesheet", href="/stylesheets/index.css")

block content
  div#contenido
    if (publicaciones && publicaciones.length > 0)
      each pub in publicaciones 
        include index_pub.pug 
    else 
      div.no-publicaciones
        h2 Aún no hay publicaciones 
        p ¡Creá la tuya!
    div#marcador-final

  script.
    const tieneDenuncias = !{JSON.stringify(tieneDenuncias || false)};
    const cachePublicaciones = {};
    const carruselStatus = {};

    const id_usuario = !{JSON.stringify(usuario ? usuario.id : null)};
    const datosIniciales = !{JSON.stringify(publicaciones || [])};

    if (tieneDenuncias) { alert('Atención: Tenés denuncias pendientes'); }
    
    datosInteresantes(datosIniciales);

    function datosInteresantes(listaPosts) {
      listaPosts.forEach(pub => {
        cachePublicaciones[pub.id] = pub.Imagens || [];
      });
    }

    // ACTUALIZAR LIKES
    async function actualizarLikes(id, valoracion, idPub) {
      try {
        const res = await fetch(`/publicacion/${id}/valoracion`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ valoracion: valoracion })
        });
        const data = await res.json();

        const contenedorBotones = document.getElementById(`contenedor-voto-pub-${idPub}`).innerHTML = '<button type="button">❤️</button>';
        const elementoPromedio = document.getElementById(`valoracion-pub-${idPub}`).innerText = data.promedio + '%';
        const elementoCantidad = document.getElementById(`cantidad-valoraciones-pub-${idPub}`).innerText = data.cantidad;

        if (cachePublicaciones[idPub]) {
            const imagenEnCache = cachePublicaciones[idPub].find(img => img.id === id);
            if (imagenEnCache) {
                imagenEnCache.promedio = data.promedio;
                imagenEnCache.cantidad = data.cantidad;
                if (!imagenEnCache.Valoracions) imagenEnCache.Valoracions = [];
                imagenEnCache.Valoracions.push({ valoracion: valoracion, id_usuario: id_usuario });
            }
        }
      } catch(error) { console.error('No se actualizó la valoración correctamente', error); }
    }

    // Crear comentario
    async function agregarComentario(evento, idPub) {
      evento.preventDefault();
      
      const formulario = evento.target;
      const cajaTexto = formulario.querySelector('textarea[name="comentario"]');
      const id_imagen = formulario.querySelector('input[name="id_imagen"]').value;
      
      if (!cajaTexto.value.trim()) return;

      try {
        const res = await fetch(`/comentario/crear`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ 
            texto: cajaTexto.value,
            id_imagen: id_imagen
          })
        });
        
        const nuevoComentario = await res.json();
        
        const fotoActualId = carruselStatus[idPub] || 0;
        if (!cachePublicaciones[idPub][fotoActualId].Comentarios) {
          cachePublicaciones[idPub][fotoActualId].Comentarios = [];
        }
        cachePublicaciones[idPub][fotoActualId].Comentarios.push(nuevoComentario);
        
        const seccion_comentarios = document.getElementById(`seccion-comentarios-${idPub}`);
        seccion_comentarios.style.display = 'none'; 
        alternarComentarios(idPub);
        
        cajaTexto.value = '';
      } catch (error) { console.error('Error al agregar:', error); }
    }

    // Eliminar comentario
    async function eliminarComentario(idPub, idComentario) {
      try {
        const res = await fetch(`/comentario/eliminar`, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: idComentario })
        });

        if (res.ok) {
          const fotoActualId = carruselStatus[idPub] || 0;
          cachePublicaciones[idPub][fotoActualId].Comentarios = cachePublicaciones[idPub][fotoActualId].Comentarios.filter(c => c.id !== idComentario);
          
          const seccion_comentarios = document.getElementById(`seccion-comentarios-${idPub}`);
          seccion_comentarios.style.display = 'none'; 
          alternarComentarios(idPub);
        }
      } catch (error) { console.error('Error al eliminar:', error); }
    }

    // Modificar comentario
    async function modificarComentario(evento, idPub, idComentario) {
      evento.preventDefault();
      const formulario = evento.target;
      const nuevoTexto = formulario.querySelector('textarea[name="nuevoComentario"]').value;

      try {
        const res = await fetch(`/publicacion/${idPub}/comentario/${idComentario}/modificar`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: idComentario,
            texto: nuevoTexto
          })
        });

        if (res.ok) {
          const fotoActualId = carruselStatus[idPub] || 0;
          const com = cachePublicaciones[idPub][fotoActualId].Comentarios.find(c => c.id === idComentario);
          if (com) com.texto = nuevoTexto;

          const seccion_comentarios = document.getElementById(`seccion-comentarios-${idPub}`);
          seccion_comentarios.style.display = 'none'; 
          alternarComentarios(idPub);
        }
      } catch (error) { console.error('Error al modificar:', error); }
    }

    // MOSTRAR / OCULTAR COMENTARIOS (Corregido leyendo del caché)
    function alternarComentarios(id) {
      const seccion_comentarios = document.getElementById(`seccion-comentarios-${id}`);
      const contenedor_comentarios = document.getElementById(`lista-comentarios-pub-${id}`);
      
      if (seccion_comentarios.style.display === 'none') {
        contenedor_comentarios.innerHTML = '';

        const fotoActualId = carruselStatus[id] || 0;
        const imagenesDelPost = cachePublicaciones[id] || [];
        const comentarios = imagenesDelPost[fotoActualId]?.Comentarios || [];

        comentarios.forEach(comentario => {
          const esMio = id_usuario && comentario.id_usuario === id_usuario;
          const foto_perfil = comentario.Usuario.foto_perfil;
          const nombre = comentario.Usuario.nombre;
          const id_comentario = comentario.id;
          const fecha_creacion = new Date(comentario.createdAt).toLocaleString();
          const texto = comentario.texto;
          const denuncias = comentario.denuncias || 0;

          let htmlComentario = '';
          if (id_usuario && esMio) {
            htmlComentario = `
              <div class="comentario-item">
                <img src="${foto_perfil}" width="32">
                <div class="comentario-cuerpo">
                  <p><strong>${fecha_creacion}</strong></p>
                  <h5>${nombre}</h5>
                  <p>${texto}</p>
                  <div class="comentario-acciones">
                    <button onclick="eliminarComentario(${id}, ${id_comentario})">🗑️</button>
                    <button onclick="alternarModificacionComentario(${id_comentario})">✏️</button>
                    <button type="button">🚩 ${denuncias}</button>
                    <div id="seccion-modificar-comentario-${id_comentario}" style="display: none;">
                      <form onsubmit="modificarComentario(event, ${id}, ${id_comentario})" method="post">
                        <textarea name="nuevoComentario" rows="2">${texto}</textarea>
                        <button type="submit">📩</button>
                      </form>
                    </div>
                  </div>
                </div>
              </div>`;
          } else {
            htmlComentario = `
              <div class="comentario-item">
                <img src="${foto_perfil}" width="32">
                <div class="comentario-cuerpo">
                  <p><strong>${fecha_creacion}</strong></p>
                  <h5>${nombre}</h5>
                  <p>${texto}</p>
                  <div class="comentario-acciones">
                    <a href="/comentario/denunciar/${id_comentario}">🚩</a>
                  </div>
                </div>
              </div>`;
          }
          contenedor_comentarios.insertAdjacentHTML('beforeend', htmlComentario);
        });

        seccion_comentarios.style.display = 'block';
      } else {
        seccion_comentarios.style.display = 'none';
      }
    }

    function alternarModificacionComentario(idCom) {
      const seccion = document.getElementById(`seccion-modificar-comentario-${idCom}`);
      seccion.style.display === 'none' ? seccion.style.display = 'block' : seccion.style.display = 'none';
    }

    function marcarInteres(idPub) {
      const motivo_Interes = document.getElementById(`motivo-interes-${idPub}`);
      motivo_Interes.style.display === 'none' ? motivo_Interes.style.display = 'block' : motivo_Interes.style.display = 'none';
    }

    function guardarPublicacion(idPub) {
      const seccion = document.getElementById(`guardarPublicacion-${idPub}`);
      seccion.style.display === 'none' ? seccion.style.display = 'block' : seccion.style.display = 'none';
    }

    // MOSTRAR SIGUIENTE/ANTERIOR IMAGEN
    function mover(idPub, direccion) {
      const imagenes = cachePublicaciones[idPub] || [];
      const total = imagenes.length;

      if (total <= 1) return;

      if (carruselStatus[idPub] === undefined) carruselStatus[idPub] = 0;
      carruselStatus[idPub] += direccion;

      if (carruselStatus[idPub] >= total) carruselStatus[idPub] = 0;
      if (carruselStatus[idPub] < 0) carruselStatus[idPub] = total - 1;

      const fotoActualId = carruselStatus[idPub];
      const nuevaImagen = imagenes[fotoActualId];

      const contenedor_imagen = document.getElementById(`imagen-container-${idPub}`);
      const textoLicencia = document.getElementById(`licencia-text-${idPub}`);
      const imagenElemento = contenedor_imagen.querySelector('.main-img');
      
      if (id_usuario) {
        imagenElemento.src = nuevaImagen.imagen;
        if (textoLicencia) textoLicencia.innerText = nuevaImagen.licencia ? 'Imagen sin licencia' : 'Imagen con licencia';
      } else if (nuevaImagen.licencia) {
        imagenElemento.src = "/images/imagen_censurada.png";
        if (textoLicencia) textoLicencia.innerText = 'Imagen con licencia';
      } else {
        imagenElemento.src = nuevaImagen.imagen;
        if (textoLicencia) textoLicencia.innerText = 'Imagen sin licencia';
      }

      const contenedorVoto = document.getElementById(`contenedor-voto-pub-${idPub}`);
      if (contenedorVoto && id_usuario) {
        const valorizo = nuevaImagen.Valoracions && nuevaImagen.Valoracions.some(v => v.id_usuario === id_usuario);
        
        if (!valorizo) {
          contenedorVoto.innerHTML = `
            <button onclick="actualizarLikes(${nuevaImagen.id}, true, ${idPub})" class="boton-like">❤️</button>
            <button onclick="actualizarLikes(${nuevaImagen.id}, false, ${idPub})" class="boton-like">🩶</button>
          `;
        } else { contenedorVoto.innerHTML = '<button type="button">❤️</button>'; }
      }

      document.getElementById(`pos-${idPub}`).innerText = `${fotoActualId + 1} / ${total}`;
      document.getElementById(`valoracion-pub-${idPub}`).innerText = `${nuevaImagen.promedio}%`;
      document.getElementById(`cantidad-valoraciones-pub-${idPub}`).innerText = nuevaImagen.cantidad;

      const totalComentarios = nuevaImagen.Comentarios ? nuevaImagen.Comentarios.length : 0;
      document.getElementById(`comentarios-pub-${idPub}`).innerText = totalComentarios;

      const inputImagen = document.getElementById(`input-imagen-comentario-${idPub}`);
      if (inputImagen) inputImagen.value = nuevaImagen.id;

      const seccion_comentarios = document.getElementById(`seccion-comentarios-${idPub}`);
      if (seccion_comentarios && seccion_comentarios.style.display === 'block') {
        seccion_comentarios.style.display = 'none'; 
        alternarComentarios(idPub);
      }
    }

    // SCROLL INFINITO
    const marcador = document.querySelector('#marcador-final');
    let idsCargados = [];
    let cargando = false;
    
    document.querySelectorAll('.contenedor-post').forEach(pub => idsCargados.push(Number(pub.dataset.id)));

    const cargarPublicaciones = async () => {
      if (cargando) return;
      cargando = true;

      try {
        const contenedorContenido = document.querySelector('#contenido');
        
        const res = await fetch('/', { 
            method: 'POST', 
            headers: { 'Content-Type': 'application/json' }, 
            body: JSON.stringify({ idsCargados }) 
        });
        const data = await res.json();

        if (data.finalizar) {
            observador.unobserve(marcador);
            return;
        }

        datosInteresantes(data.publicaciones);
        marcador.insertAdjacentHTML('beforebegin', data.html);

        idsCargados = [];
        document.querySelectorAll('.contenedor-post').forEach(pub => idsCargados.push(Number(pub.dataset.id)));

      } catch(error) { 
          console.error('Error al cargar más publicaciones:', error);
      } finally { cargando = false; }
    };

    const observador = new IntersectionObserver((entries) => { if (entries[0].isIntersecting) cargarPublicaciones(); }, { rootMargin: '300px' });

    if (marcador) observador.observe(marcador);