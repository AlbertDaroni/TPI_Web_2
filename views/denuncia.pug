extends layout 

block estilo 
    link(rel="stylesheet", href="/stylesheets/denuncia.css")

block content 
    div#contenido
        h3 Reportar un problema
        p Por favor, describí el motivo de tu denuncia.
        
        if (tipo === "imagen")
            form(action=`/publicacion/denunciar`, method="post") 
                label(for="descripcion") Motivo de la denuncia
                textarea(name="motivo", required) 
                input(type="hidden", name="id_imagen", value=id_imagen)
                button(type="submit") Enviar reporte
        else if (tipo === "comentario")
            form(action=`/comentario/denunciar`, method="post") 
                label(for="descripcion") Motivo de la denuncia
                textarea(name="motivo", required) 
                input(type="hidden", name="id_comentario", value=id_comentario)
                button(type="submit") Enviar reporte
        else
            p No se ha encontrado el objeto a denunciar