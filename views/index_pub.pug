div.contenedor-post(data-id=pub.id)
  div.publicacion(id=`pub-${pub.id}`)
    div.perfil-header(onclick=`location.href="/usuario/${pub.Usuario.id}/perfil"`)
      img(src=pub.Usuario.foto_perfil, width="40")
      h5= pub.Usuario.nombre

    div.cuerpo-publicacion
      div.foto-seccion
        - var imagenActiva = pub.Imagens[0]
        div(id=`imagen-container-${pub.id}`, onclick=`location.href="/publicacion/ver/${pub.id}"`)
          if (usuario)
            img.main-img(src=imagenActiva.imagen, style="width: 100%")
            p(id=`licencia-text-${pub.id}`)= (imagenActiva.licencia) ? 'Imagen con licencia' : 'Imagen sin licencia'
            if (imagenActiva.licencia && imagenActiva.marcaDeAgua)
              span.marca-agua-texto(id=`marca-agua-${pub.id}`)= imagenActiva.marcaDeAgua
          else if (imagenActiva.licencia)
            img.main-img(src="/images/imagen_censurada.png", style="width: 100%")
            p(id=`licencia-text-${pub.id}`) Imagen con licencia
            if (imagenActiva.licencia && imagenActiva.marcaDeAgua)
              span.marca-agua-texto(id=`marca-agua-${pub.id}`)= imagenActiva.marcaDeAgua
          else 
            img.main-img(src=imagenActiva.imagen, style="width: 100%")
            p(id=`licencia-text-${pub.id}`) Imagen sin licencia
        
        if (pub.Imagens.length > 1)
          button(onclick=`mover(${pub.id}, -1)`) ◀️
          span(id=`pos-${pub.id}`) 1 / #{pub.Imagens.length}
          button(onclick=`mover(${pub.id}, +1)`) ▶️

      div#informacion
        if (usuario && pub.id_usuario === usuario.id && pub.modificable)
          form(onsubmit=`modificarPublicacion(event, ${pub.id})`, method="post") 
            div#seccion-etiquetas
              if (pub.Etiqueta && pub.Etiqueta.length > 0)
                each etiqueta in pub.Etiqueta 
                  div(id="etiqueta", style="display: inline-block;")
                    input(type="text", name="nuevaEtiqueta[]", value=etiqueta.nombre, required)
                    input(type="hidden", name="nuevaEtiquetaId[]", value=etiqueta.id, required)
                    button(type="button", onclick=`eliminarEtiqueta(this, ${etiqueta.id})`) 🗑️
            button(type="button", onclick="nuevaEtiqueta()") ➕
            h5
              input(type="text", name="nuevoTitulo", value=pub.titulo)
            p= new Date(pub.createdAt).toLocaleDateString()
            p 
              textarea(name="nuevaDescripcion", cols="92", rows="10")= pub.descripcion
            button(type="submit") Modificar
        else
          if (pub.Etiqueta && pub.Etiqueta.length > 0)
            each etiqueta in pub.Etiqueta 
              a(href=`/publicacion/etiqueta/${etiqueta.nombre}`, id=`etiqueta-${etiqueta.id}`, style="display: inline-block; margin-right: 5px;")= '#' + etiqueta.nombre
          h5= pub.titulo
          p= new Date(pub.createdAt).toLocaleDateString()
          p= pub.descripcion

      div#acciones
        if (usuario && pub.id_usuario !== usuario.id)
          - var valorizo = imagenActiva.Valoracions && imagenActiva.Valoracions.some(v => v.id_usuario === usuario.id)
          - var valoracion = imagenActiva.Valoracions && imagenActiva.Valoracions.find(v => v.id_usuario === usuario.id)
          if (!valorizo)
            div(id=`contenedor-valoraciones-pub-${pub.id}`)
              div(id=`contenedor-voto-pub-${pub.id}`, style="display: inline-block;")
                button(onclick=`actualizarLikes(${imagenActiva.id}, ${true}, ${pub.id})`, class="boton-like", title="Me gusta") ❤️
                button(onclick=`actualizarLikes(${imagenActiva.id}, ${false}, ${pub.id})`, class="boton-like", title="No me gusta") 🩶
              span(id=`valoracion-pub-${pub.id}`)= imagenActiva.promedio + '%'
              span(id=`cantidad-valoraciones-pub-${pub.id}`)= imagenActiva.cantidad
          else 
            div(id=`contenedor-valoraciones-pub-${pub.id}`)
              button(type="button", class="boton-like")= valoracion.valoracion ? '❤️' : '🩶'
                span(id=`valoracion-pub-${pub.id}`)= imagenActiva.promedio + '%'
                span(id=`cantidad-valoraciones-pub-${pub.id}`)= imagenActiva.cantidad
          button(onclick=`alternarComentarios(${pub.id})`, title="Comentarios") 💬
            span(id=`comentarios-pub-${pub.id}`)= imagenActiva.Comentarios.length
          button(onclick=`alternarFormGuardarPublicacion(${pub.id})`, title="Guardar como favorito") 📁
          button(onclick=`marcarInteres(${pub.id}, ${pub.id_usuario})`, title="Me interesa") ⭐
          a(href=`/imagen/denunciar/${imagenActiva.id}`, title="Denunciar", id=`link-denunciar-img-pub-${pub.id}`) 🚩
        else
          div(id=`contenedor-valoraciones-pub-${pub.id}`)
            button(type="button", class="boton-like") ❤️
              span(id=`valoracion-pub-${pub.id}`)= imagenActiva.promedio + '%'
              span(id=`cantidad-valoraciones-pub-${pub.id}`)= imagenActiva.cantidad
          div 
            button(onclick=`alternarComentarios(${pub.id})`, title="Comentarios") 💬
              span(id=`comentarios-pub-${pub.id}`)= imagenActiva.Comentarios.length
            if (usuario && pub.id_usuario === usuario.id && pub.modificable)
              - var color = imagenActiva.comentarios ? '🟢' : '🔴'
              button(onclick=`cerrarAbrirComentarios(${imagenActiva.id}, ${imagenActiva.comentarios})`, id=`btn-cerrarAbrir-comentarios-pub-${pub.id}`) #{color}
          if (usuario && pub.id_usuario === usuario.id && pub.modificable)
            button(onclick=`eliminarImagen(${imagenActiva.id})`, title="Eliminar imagen", id=`btn-eliminar-img-pub-${pub.id}`) ✂️
            button(onclick=`eliminarPublicacion(${pub.id})`, title="Eliminar publicación") 🗑️

      div(id=`guardarPublicacion-${pub.id}`, style="display: none;")
        form(onsubmit=`guardarPublicacion(event, ${pub.id})`, method="post")
          input(id=`input-nombreLista-${pub.id}`, type="text", name="nombreLista", placeholder="Nombre de la lista", required) 
          button(type="submit") 📩

  div(id=`seccion-comentarios-${pub.id}`, style="display: none;")
    div.form-comentario
      if (usuario && imagenActiva.comentarios)
        form(id=`form-agregar-comentario-${pub.id}`, onsubmit=`agregarComentario(event, ${pub.id})`, method="post") 
          input(type="hidden", name="id_imagen", id=`input-imagen-comentario-${pub.id}`, value=imagenActiva.id)
          textarea(name='comentario', cols="30", rows="5", placeholder="Escribí un comentario...")
          button(type="submit") Comentar
    div(id=`lista-comentarios-pub-${pub.id}`)