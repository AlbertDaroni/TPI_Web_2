extends layout 

block estilo 
    link(rel="stylesheet", href="/stylesheets/agregar.css")

block content 
    div#contenido
        h4 Crear una publicación 
        form#form-crear-pub(action="/publicacion/crear", method="post", enctype="multipart/form-data") 
            label(for="titulo") Título 
            input(type="text", name="titulo", required)

            label(for="descripcion") Descripción
            textarea(name="descripcion", cols="50", rows="5") 

            label(for="imagenes") Imágenes (hasta 5)
            input#input-imagenes(type="file", name="imagenes", multiple, required)
            div#contenedor-previsualizaciones

            label(for="etiquetas") Añadir etiquetas (hasta 5)
            div#seccion-etiquetas
                div.fila-etiqueta
                    input(type="text", name="etiquetas[]", required)
            button(type="button", onclick="nuevaEtiqueta()") Agregar nueva etiqueta

            button(type="submit") Crear

    script.
        script.
        const inputImagenes = document.getElementById('input-imagenes');
        const contenedorPrev = document.getElementById('contenedor-previsualizaciones');
        const formCrearPub = document.getElementById('form-crear-pub');
        
        let archivosSeleccionados = [];

        inputImagenes.addEventListener('change', function() {
            contenedorPrev.innerHTML = '';
            archivosSeleccionados = Array.from(this.files);

            if (archivosSeleccionados.length > 5) {
                alert('Solo podés subir hasta 5 fotos');
                this.value = '';
                return;
            }

            archivosSeleccionados.forEach((archivo, indice) => {
                const lector = new FileReader();
                lector.onload = function(evento) {
                    const html = document.createElement('div');
                    html.className = 'tarjeta-previsualizacion';
                    html.innerHTML = `
                        <div class="contenedor-prev-imagen">
                            <img src="${evento.target.result}" alt="Previsualización" style="width: 80px; height: 80px; object-fit: cover;">
                        </div>
                        <div class="contenedor-prev-opciones">
                            <h5>Configuración de la imagen #${indice + 1}</h5>
                            <div class="opcion-grupo">
                                <label>Licencia</label>
                                <div class="radio-opciones">
                                    <input type="radio" name="licencias[${indice}]" value="true"> Sí
                                    <input type="radio" name="licencias[${indice}]" value="false" checked> No
                                </div>
                            </div>
                            <div class="opcion-grupo">
                                <label>Añadir Marca de Agua</label>
                                <input type="text" name="marcasDeAgua[${indice}]" placeholder="Escribí el texto...">
                            </div>
                        </div>
                    `;
                    contenedorPrev.appendChild(html);
                };
                lector.readAsDataURL(archivo);
            });
        });

        formCrearPub.addEventListener('submit', async function(e) {
            e.preventDefault();
            
            if (archivosSeleccionados.length === 0) return alert('Debés cargar al menos una imagen');

            // CLOUDINARY CONFIG: Reemplazá esto con tus datos de Cloudinary
            const CLOUD_NAME = "dthkzpy1e"; 
            const UPLOAD_PRESET = "imagenURL"; 

            try {
                const promesasSubida = archivosSeleccionados.map(archivo => {
                    const formDataCloudinary = new FormData();
                    formDataCloudinary.append('file', archivo);
                    formDataCloudinary.append('upload_preset', UPLOAD_PRESET);

                    return fetch(`https://cloudinary.com{CLOUD_NAME}/image/upload`, {
                        method: 'POST',
                        body: formDataCloudinary
                    }).then(res => {
                        if (!res.ok) throw new Error('Error al subir a Cloudinary');
                        return res.json();
                    });
                });

                const resultadosCloudinary = await Promise.all(promesasSubida);
                const urlsImagenes = resultadosCloudinary.map(res => res.secure_url);

                const formDataPropio = new FormData(formCrearPub);
                const etiquetas = Array.from(formDataPropio.getAll('etiquetas[]'));
                
                const licencias = archivosSeleccionados.map((_, i) => {
                    const radio = document.querySelector(`input[name="licencias[${i}]"]:checked`);
                    return radio ? radio.value === 'true' : false;
                });
                const marcasDeAgua = archivosSeleccionados.map((_, i) => {
                    const input = document.querySelector(`input[name="marcasDeAgua[${i}]"]`);
                    return input ? input.value : "";
                });

                const payload = {
                    titulo: formDataPropio.get('titulo'),
                    descripcion: formDataPropio.get('descripcion'),
                    etiquetas: etiquetas,
                    imagenes: urlsImagenes,
                    licencias: licencias,
                    marcasDeAgua: marcasDeAgua
                };

                const respuestaBackend = await fetch('/publicacion/crear', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (respuestaBackend.ok) { window.location.href = '/'; }
                else { alert('Hubo un error al guardar la publicación.'); }

            } catch (error) {
                console.error(error);
                alert('Error en el proceso de carga de imágenes.');
            }
        });

        function nuevaEtiqueta() {
            const seccion_etiquetas = document.getElementById('seccion-etiquetas');
            const cantidad_actual = seccion_etiquetas.querySelectorAll('.fila-etiqueta').length;
            const contenedor = document.createElement('div');
            if (cantidad_actual > 4) return alert('Solo podés añadir hasta 5 etiquetas');
            contenedor.className = 'fila-etiqueta';
            contenedor.innerHTML = `
                <input type="text" name="etiquetas[]" required>
                <button type="button" onclick="eliminarEtiqueta(this)">🗑️</button>
            `;
            seccion_etiquetas.appendChild(contenedor);
        }

        function eliminarEtiqueta(boton) { boton.parentElement.remove(); }
        function eliminarImagen(boton) { boton.parentElement.remove(); }