extends layout 

block estilo 
    link(rel="stylesheet", href="/stylesheets/agregar.css")

block content 
    div#contenido
        h4 Crear una publicación 
        form#form-crear-pub(action="/publicacion/crear", method="post", enctype="multipart/form-data") 
            label(for="titulo") Título 
            input(type="text", name="titulo", required)

            label(for="descripcion") Descripción
            textarea(name="descripcion", cols="50", rows="5") 

            label(for="imagenes") Imágenes (hasta 5)
            input#input-imagenes(type="file", name="imagenes", multiple, required)
            div#contenedor-previsualizaciones

            label(for="etiquetas") Añadir etiquetas (hasta 5)
            div#seccion-etiquetas
                div.fila-etiqueta
                    input(type="text", name="etiquetas[]", required)
            button(type="button", onclick="nuevaEtiqueta()") Agregar nueva etiqueta

            button(type="submit") Crear

    script.
        const inputImagenes = document.getElementById('input-imagenes');
        const contenedorPrev = document.getElementById('contenedor-previsualizaciones');
        const formulario = document.getElementById('form-crear-pub');

        if (formulario) {
            formulario.addEventListener('submit', async function(evento) {
                evento.preventDefault();
                
                const btnSubmit = this.querySelector('button[type="submit"]');
                btnSubmit.disabled = true;
                btnSubmit.innerText = 'Subiendo... ⏳';

                const inputFiles = document.getElementById('input-imagenes');
                const arrayBase64Promesas = [];

                for (let i = 0; i < inputFiles.files.length; i++) {
                    const archivoComprimido = await comprimirImagen(inputFiles.files[i]);
                    
                    const promesaBase64 = new Promise((resolve) => {
                        const lector = new FileReader();
                        lector.readAsDataURL(archivoComprimido);
                        lector.onloadend = () => resolve(lector.result);
                    });
                    arrayBase64Promesas.push(promesaBase64);
                }

                const imagenesBase64 = await Promise.all(arrayBase64Promesas);

                const tituloVal = this.querySelector('input[name="titulo"]').value;
                const descVal = this.querySelector('textarea[name="descripcion"]').value;
                
                const licencias = Array.from(this.querySelectorAll('input[name^="licencias"]:checked')).map(el => el.value);
                const marcasDeAgua = Array.from(this.querySelectorAll('input[name^="marcasDeAgua"]:checked')).map(el => el.value);
                const etiquetas = Array.from(this.querySelectorAll('input[name="etiquetas[]"]')).map(el => el.value);

                try {
                    const res = await fetch('/publicacion/crear', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ 
                            titulo: tituloVal, 
                            descripcion: descVal, 
                            licencias, 
                            marcasDeAgua, 
                            etiquetas, 
                            imagenes: imagenesBase64
                        })
                    });

                    if (res.ok) {
                        window.location.href = '/';
                    } else {
                        alert('Error al crear la publicación');
                        btnSubmit.disabled = false;
                        btnSubmit.innerText = 'Crear';
                    }
                } catch (err) {
                    console.error(err);
                    btnSubmit.disabled = false;
                }
            });
        }

        inputImagenes.addEventListener('change', function() {
            contenedorPrev.innerHTML = '';
            const archivos = this.files;

            if (archivos.length > 5) {
                alert('Solo podés subir hasta 5 fotos');
                this.value = '';
                return;
            }

            if (archivos.length > 0) {
                Array.from(archivos).forEach((archivo, indice) => {
                    const lector = new FileReader();

                    lector.onload = function(evento) {
                        const html = document.createElement('div');
                        html.className = 'tarjeta-previsualizacion';

                        html.innerHTML = `
                            <div class="contenedor-prev-imagen">
                                <img src="${evento.target.result}" alt="Previsualización">
                            </div>
                            <div class="contenedor-prev-opciones">
                                <h5>Configuración de la imagen #${indice + 1}</h5>
                                <div class="opcion-grupo">
                                    <label>Licencia</label>
                                    <div class="radio-opciones">
                                        <input type="radio" name="licencias[${indice}]" value="true"> Sí
                                        <input type="radio" name="licencias[${indice}]" value="false" checked> No
                                    </div>
                                </div>
                                <div class="opcion-grupo">
                                    <label>Añadir Marca de Agua</label>
                                    <input type="text" name="marcasDeAgua[${indice}]">
                                </div>
                            </div>
                            <button type="button" onclick="eliminarImagen(this)">🗑️</button>
                        `;
                        contenedorPrev.appendChild(html);
                    };

                    lector.readAsDataURL(archivo);
                });
            }
        });

        function nuevaEtiqueta() {
            const seccion_etiquetas = document.getElementById('seccion-etiquetas');
            const cantidad_actual = seccion_etiquetas.querySelectorAll('.fila-etiqueta').length;
            const contenedor = document.createElement('div');

            if (cantidad_actual > 4) return alert('Solo podés añadir hasta 5 etiquetas');

            contenedor.className = 'fila-etiqueta';

            contenedor.innerHTML = `
                <input type="text" name="etiquetas[]" required>
                <button type="button" onclick="eliminarEtiqueta(this)">🗑️</button>
            `;

            seccion_etiquetas.appendChild(contenedor);
        }

        function eliminarImagen(boton) { boton.parentElement.remove(); }
        function eliminarEtiqueta(boton) { boton.parentElement.remove(); }

        function comprimirImagen(archivo) {
            return new Promise((resolve) => {
                const lector = new FileReader();
                lector.readAsDataURL(archivo);
                lector.onload = (evento) => {
                    const img = new Image();
                    img.src = evento.target.result;
                    img.onload = () => {
                        const canvas = document.createElement('canvas');
                        const MAX_ANCHO = 800;
                        let ancho = img.width;
                        let alto = img.height;

                        if (ancho > MAX_ANCHO) {
                            alto *= MAX_ANCHO / ancho;
                            ancho = MAX_ANCHO;
                        }

                        canvas.width = ancho;
                        canvas.height = alto;
                        const ctx = canvas.getContext('2d');
                        ctx.drawImage(img, 0, 0, ancho, alto);

                        canvas.toBlob((blob) => {
                            resolve(new File([blob], archivo.name, { type: 'image/jpeg' }));
                        }, 'image/jpeg', 0.6);
                    };
                };
            });
        }