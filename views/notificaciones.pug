extends layout 

block estilo 
    link(rel="stylesheet", href="/stylesheets/listas.css")

block content 
    div.lista-container
        h3 Notificaciones 
        div.acciones
            div.botones-acciones
                form(action=`/notificacion/filtrar`, method="post") 
                    select(name="opcion")
                        option(value="todas") Todas
                        option(value="no-leidas") No leídas 
                        option(value="leidas") Leídas 
                        option(value="Seguimiento") Seguimiento
                        option(value="Comentó") Comentarios
                        option(value="Interés") Intereses 
                        option(value="Valorizó") Valoraciones 
                        option(value="Denuncia") Denuncias 
                    button(type="submit") Filtrar   
                button#boton-marcar-todas(onclick=`actualizarTodasVisto()`) Marcar todas
                a(href='/notificacion/eliminar') Eliminar todas

        if (notificaciones && notificaciones.length > 0)
            each n in notificaciones 
                div.notificacion-item(class=(n.vista ? "" : "no-leida"))
                    img(src=n.Causante.foto_perfil, onclick=`location.href='/usuario/${n.id_causante}/perfil'`)

                    - var urlPub = ''
                    if (n.Comentario)
                        - urlPub = `location.href='/publicacion/ver/${n.Comentario.Imagen.id_publicacion}'`
                    else if (n.Imagen && n.Imagen.Publicacion)
                        - urlPub = `location.href='/publicacion/ver/${n.Imagen.Publicacion.id}'`
                        
                    div.info-notificacion(onclick=urlPub)
                        p
                            strong= n.Causante.nombre
                            if (n.tipo_evento === "Interés")
                                |  se interesó en tu publicación 
                                if (n.Imagen && n.Imagen.Publicacion)
                                    strong= ` "${n.Imagen.Publicacion.titulo}"`
                                br
                                if (n.motivo)
                                    small= n.motivo

                            else if (n.tipo_evento === "Nuevo seguidor")
                                |  comenzó a seguirte.

                            else if (n.tipo_evento === "Dejó de seguirte")
                                |  dejó de seguirte.

                            else if (n.tipo_evento === "Valorizó")
                                |  valorizó tu publicación 
                                if (n.Imagen && n.Imagen.Publicacion)
                                    strong= ` "${n.Imagen.Publicacion.titulo}"`

                            else if (n.tipo_evento === "Comentó")
                                |  comentó tu publicación 
                                if (n.Comentario)
                                    span= `"${n.Comentario.texto}"`

                            else if (n.tipo_evento === "Denuncia")
                                |  hizo una denuncia.
                                if (n.Imagen && n.Imagen.Publicacion)
                                    strong= ` "${n.Imagen.Publicacion.titulo}"`
                                if (n.Comentario)
                                    br
                                    span= `${n.Comentario.texto}`
                                br
                                if (n.motivo)
                                    small= `⚠️ ${n.motivo}`
                            else
                                |  interactuó con vos.
                        
                        small= new Date(n.createdAt).toLocaleDateString()

                    if (n.vista)
                        button(type="button", id=`boton-visto-${n.id}`, class="btn-visto") ✔️
                    else 
                        button(onclick=`actualizarVisto(${n.id})`, id=`boton-visto-${n.id}`, class="btn-visto") ✖️
        else 
            p No hay notificaciones

    script.
        const notificaciones = !{JSON.stringify(notificaciones || null)};

        // ACTUALIZAR VISTO
        async function actualizarVisto(id) {
            try {
                const boton_visto = document.getElementById(`boton-visto-${id}`);
                const res = await fetch(`/notificacion/actualizarVisto`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id })
                });
                const data = await res.json();
                (data.vista) ? boton_visto.innerText = "✔️" : boton_visto.innerText = "✖️";
                if (data.vista) boton_visto.removeAttribute('onclick');
            } catch (error) { console.error("Error:", error); }
        }

        // MARCAR TODAS COMO VISTO
        async function actualizarTodasVisto() {
            try {
                const ids = notificaciones.map(n => n.id);
                for (const id of ids) {
                    const boton_visto = document.getElementById(`boton-visto-${id}`);
                    const res = await fetch(`/notificacion/actualizarVisto`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ id })
                    });
                    const data = await res.json();
                    (data.vista) ? boton_visto.innerText = "✔️" : boton_visto.innerText = "✖️";
                    if (data.vista) boton_visto.removeAttribute('onclick');
                }
            } catch (error) { console.error("Error:", error); }
        }